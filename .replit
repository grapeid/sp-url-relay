modules = ["go-1.25", "postgresql-16"]
[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/start.sh"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 3000
externalPort = 3000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 10042
externalPort = 3001

[[ports]]
localPort = 10043
externalPort = 3003

[[ports]]
localPort = 10044
externalPort = 4200

[[ports]]
localPort = 10045
externalPort = 5000

[[ports]]
localPort = 10046
externalPort = 3002

[[ports]]
localPort = 10047
externalPort = 5173

[[ports]]
localPort = 10048
externalPort = 6000

[nix]
channel = "stable-25_05"

[deployment]
deploymentTarget = "cloudrun"
run = ["bash", "scripts/start.sh"]
build = ["bash", "-c", "bash scripts/install.sh && CGO_ENABLED=0 go build -o bin/relay ./cmd/relay"]
